{
  "expo": {
    "name": "Kanban Tasks",
    "slug": "kanban-tasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EDE2"
    },
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": [
      "kanban-tasks",
      "com.googleusercontent.apps.957410363710-o0pllt9lsun0r806ogr3hcojrbnf7n72"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.janasue.kanbantasks",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Planner verwendet die Kamera, um Dokumente als PDF zu scannen.",
        "NSLocalNetworkUsageDescription": "Planner verbindet sich mit deinem Synology NAS im Heimnetz, um ausgewählte Dokumente offline bereitzuhalten und von dir ausgewählte Dateien hochzuladen."
      },
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.janasue.kanbantasks.widgets",
          "groupIdentifier": "group.com.janasue.kanbantasks",
          "widgets": [
            {
              "name": "TodayTasks",
              "displayName": "Heute",
              "description": "Heute fällige und überfällige Aufgaben auf einen Blick.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/TodayTasks.tsx"
              }
            },
            {
              "name": "TasksOverview",
              "displayName": "Aufgabenübersicht",
              "description": "Deine offenen Aufgaben und Listen im Überblick.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/TasksOverview.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "extensionBundleIdentifier": "com.janasue.kanbantasks.ShareExtension",
            "appGroupId": "group.com.janasue.kanbantasks",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      "expo-app-intents",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Planner verwendet Face ID, um deine Aufgaben, Kalender und Dokumente zu schützen."
        }
      ],
      "./plugins/withNotificationAppIcons"
    ],
    "experiments": {
      "typedRoutes": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents",
          "native"
        ]
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "246e8c30-5044-48c4-8e5a-34c8ca8aded4"
      }
    },
    "owner": "janasue"
  }
}
